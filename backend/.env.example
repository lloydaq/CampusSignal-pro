# Copy to backend/.env for local development. Never commit .env.
# Variables are documented in architecture.md §19; values here are local-only examples.

# local | ci | staging | production   (required)
APP_ENV=local
# Origin of the web app; must be https in staging/production   (required)
APP_ORIGIN=http://localhost:5173
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
