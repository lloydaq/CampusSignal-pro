# Copy to backend/.env for local development. Never commit .env.
# Variables are documented in architecture.md §19; values here are placeholders only.

# local | ci | staging | production   (required)
APP_ENV=local
# Origin of the web app; must be https in staging/production   (required)
APP_ORIGIN=http://localhost:5173
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# PostgreSQL 17 connection (required). Local development uses your Supabase development
# project's SESSION POOLER string (Dashboard > Connect > Session pooler, port 5432), with:
#   - the scheme changed to postgresql+psycopg://
#   - ?sslmode=require appended (required for any non-localhost database)
# URL-encode special characters in the password. Turn OFF the Supabase Data API.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Integration tests only (they downgrade migrations): a DISPOSABLE Postgres 17, never the
# Supabase development project. Normally set only in CI. The tests refuse Supabase hosts.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/campussignal_test
